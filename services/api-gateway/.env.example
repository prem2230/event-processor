NODE_ENV=development
LOG_FORMAT=pretty
LOG_LEVEL=info
PORT=3000

KAFKA_BROKER=localhost:9092
KAFKA_CLIENT_ID=banking-event-platform
KAFKA_TRANSACTION_CREATED_TOPIC=transaction.created

USER_SERVICE_URL=http://localhost:3004
ACCOUNT_SERVICE_URL=http://localhost:3005
INTERNAL_SERVICE_TOKEN=replace-with-the-same-long-random-secret

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=banking-api-gateway
JWT_AUDIENCE=banking-platform
JWT_EXPIRES_IN_SECONDS=900
UPSTREAM_TIMEOUT_MS=3000
