# Docker Compose environment.
# Copy this file to `.env` at the repository root before running `docker compose up`.

# Use separate databases for each service. For MongoDB Atlas this usually looks like:
# mongodb+srv://<user>:<password>@<cluster-host>/users?retryWrites=true&w=majority
USER_SERVICE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/users?retryWrites=true&w=majority
ACCOUNT_SERVICE_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/accounts?retryWrites=true&w=majority
EVENT_PROCESSOR_MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/event_processor?retryWrites=true&w=majority

# Must match across api-gateway, user-service, and account-service.
INTERNAL_SERVICE_TOKEN=replace-with-the-same-long-random-secret

# API Gateway JWT signing secret.
JWT_SECRET=replace-with-at-least-32-random-characters
